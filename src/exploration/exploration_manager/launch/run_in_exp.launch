<launch>
  <!-- size of map, change the size in x, y, z -->
  <arg name="map_size_x" value="80.0"/>
  <arg name="map_size_y" value="30.0"/>
  <arg name="map_size_z" value="9.5"/>

  <!-- topic of odometry such as VIO or LIO -->
  <arg name="odom_topic" value="/Odom_high_freq" />

  <!-- main algorithm params -->
  <include file="$(find exploration_manager)/launch/algorithm_exp.xml">

    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>

    <arg name="box_min_x" value="0.0"/>
    <arg name="box_min_y" value="-10.0"/>
    <arg name="box_min_z" value="1.0"/>
    <arg name="box_max_x" value="30.0"/>
    <arg name="box_max_y" value="10.0"/>
    <arg name="box_max_z" value="8.0"/>

    <arg name="odometry_topic" value="$(arg odom_topic)"/>
    <!-- 1: sensor pose, 2: odometry -->
    <arg name="pose_type" value="2"/>
    <!-- sensor pose: transform of camera frame in the world frame -->
    <arg name="sensor_pose_topic" value="nouse1"/>
    <!-- extrinsic parameters of depth camera -->
    <arg name="extrinsic_topic" value="nouse2"/>
    <!-- depth topic: depth image, 640x480 by default -->
    <arg name="depth_topic" value="nouse3"/>
    <!-- cloud in world frame -->
    <arg name="cloud_topic" value="/cloud_registered"/>

    <!-- intrinsic params of sensors including depth camera and LiDAR -->
    <arg name="max_dist_lidar" value="16.0"/>
    <arg name="max_dist_camera" value="5.0"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>

    <!-- maximum velocity and acceleration the drone will reach -->
    <arg name="max_vel" value="0.5" />
    <arg name="max_acc" value="1.0" />

    <arg name="resolution" value="0.25" />

  </include>

  <!-- trajectory server -->
  <!-- visualize the position, Bspline trajectory and field of view -->
  <node pkg="plan_manage" name="traj_server" type="traj_server" output="screen">
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/time_forward" value="1.5" type="double"/>
    <param name="traj_server/pub_traj_id" value="4" type="int"/>
    <param name="perception_utils/top_angle" value="0.56125" type="double"/>
    <param name="perception_utils/left_angle" value="0.69222" type="double"/>
    <param name="perception_utils/right_angle" value="0.68901" type="double"/>
    <param name="perception_utils/max_dist" value="4.5" type="double"/>
    <param name="perception_utils/vis_dist" value="1.0" type="double"/>
  </node>

  <!-- <node pkg="exploration_manager" name="trajectory_recorder" type="trajectory_recorder" output="screen">
    <param name="save_dir" value="$(find exploration_manager)/data" /> 
    <param name="file_name" value="trajectory.csv" />
    <param name="record_rate" value="10.0" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="cam0_ext_topic" value="/vins_fusion/extrinsic" />
  </node> -->

</launch>
